{
  "name": "@exclave/signalsmith-stretch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm run test:types && pnpm run test",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --passWithNoTests --exclude \"tests/browser/**\"",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:types": "tsc -p tsconfig.json --noEmit --pretty"
  },
  "dependencies": {
    "@exclave/seqlok": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
