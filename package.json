{
  "name": "seqwire",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Typed shared-memory research for timing-sensitive JavaScript runtimes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maikeleckelboom/seqwire.git"
  },
  "homepage": "https://github.com/maikeleckelboom/seqwire#readme",
  "bugs": {
    "url": "https://github.com/maikeleckelboom/seqwire/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "fast-check": "catalog:",
    "markdownlint-cli2": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "simple-git-hooks": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "clean:artifacts": "pnpm -r -F \"@exclave/seqwire\" -F \"@exclave/docs\" run clean && rimraf .eslintcache node_modules/.vite node_modules/.cache pnpm-debug.log",
    "clean:workspace": "pnpm run clean:artifacts",
    "clean:dry": "git clean -xfdn -e .env -e \".env.*\"",
    "clean": "git clean -xfd -e .env -e \".env.*\"",
    "clean:cache": "rimraf node_modules/.vite node_modules/.cache packages/*/node_modules/.vite packages/*/node_modules/.cache apps/*/node_modules/.vite apps/*/node_modules/.cache",
    "clean:caches": "pnpm run clean:cache",
    "purge": "pnpm run clean",
    "build": "pnpm -w run clean:artifacts && pnpm -r -F \"@exclave/seqwire\" run build",
    "test": "pnpm -w -F \"@exclave/seqwire\" run test",
    "bench": "pnpm -w -F \"@exclave/seqwire\" run bench",
    "bench:report": "pnpm -w -F \"@exclave/seqwire\" run bench:report",
    "test:types": "pnpm -w -F \"@exclave/seqwire\" run test:types",
    "test:watch": "pnpm run test --watch",
    "test:cov": "pnpm -w -F \"@exclave/seqwire\" run test:cov",
    "test:pack": "pnpm -w -F \"@exclave/seqwire\" run test:pack",
    "commitlint": "commitlint --color",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint": "pnpm -r -F \"@exclave/seqwire\" -F \"@exclave/docs\" run lint",
    "lint:fix": "pnpm -r -F \"@exclave/seqwire\" -F \"@exclave/docs\" run lint:fix",
    "lint:all": "pnpm lint && pnpm lint:md",
    "format": "prettier --ignore-path .prettierignore --write .",
    "docs:check": "pnpm docs:build",
    "docs:dev": "pnpm -F @exclave/docs run docs:dev",
    "docs:build": "pnpm -F @exclave/docs run docs:build",
    "docs:preview": "pnpm -F @exclave/docs run docs:preview",
    "signalsmith:dev": "pnpm --filter \"@exclave/signalsmith-stretch\" run dev",
    "signalsmith:build": "pnpm --filter \"@exclave/signalsmith-stretch\" run build",
    "signalsmith:check": "pnpm --filter \"@exclave/signalsmith-stretch\" run check",
    "signalsmith:test:browser": "pnpm --filter \"@exclave/signalsmith-stretch\" run test:browser",
    "check:diff-whitespace": "git diff --check origin/main...HEAD",
    "support": "node scripts/support/seqwire-support.ts",
    "fresh": "pnpm clean && pnpm install --frozen-lockfile && pnpm build && pnpm signalsmith:build",
    "verify": "pnpm clean:artifacts && pnpm build && pnpm lint && pnpm test:types && pnpm test && pnpm signalsmith:check && pnpm run docs:check && pnpm test:pack && pnpm support --json",
    "verify:fresh": "pnpm fresh && pnpm lint && pnpm test:types && pnpm test && pnpm signalsmith:check && pnpm run docs:check && pnpm test:pack && pnpm support --json && pnpm signalsmith:test:browser"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "packageManager": "pnpm@11.6.0"
}
